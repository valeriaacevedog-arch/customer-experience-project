      <aliases enabled='yes' />
      <column caption='Completation Rate' datatype='real' name='[Calculation_5842940671291392]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [process_step] = &apos;confirm&apos; THEN [client_id] END) / COUNTD([client_id])*100' />
      </column>
      <column caption='Completion Rate by Steps' datatype='real' name='[Calculation_5842941958164486]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([client_id]) / ATTR({EXCLUDE [process_step]: COUNTD([client_id])})*100' />
      </column>
      <column caption='Min Time Step 1' datatype='datetime' name='[Calculation_5842941973037066]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{FIXED [client_id]: MIN(IF [process_step] = &apos;step_1&apos; THEN [date_time] END)}' />
      </column>
      <column caption='Max Time Start' datatype='datetime' name='[Calculation_5842941973139467]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{FIXED [client_id]: MAX(IF [process_step] = &apos;start&apos; THEN [date_time] END)}' />
      </column>
      <column caption='Error_Flag' datatype='integer' name='[Calculation_5842941973233676]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_5842941973139467] &gt; [Calculation_5842941973037066] THEN 1 ELSE 0 END' />
      </column>
      <column caption='Final Error Rate %' datatype='real' name='[Calculation_5842941973307405]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_5842941973233676]) / COUNTD([client_id])*100' />
      </column>
      <column caption='Clnt Age (bin)' datatype='integer' name='[Clnt Age (bin)]' role='dimension' type='ordinal'>
        <calculation class='bin' decimals='1' formula='[clnt_age]' peg='0' size='10' />
      </column>
