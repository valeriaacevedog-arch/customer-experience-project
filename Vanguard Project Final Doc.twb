        <zone flipboard-zone-id='5' forceUpdate='true' h='80102' hidden='true' id='42' story-point-id='19' type-v2='text' w='92671' x='3176' y='17730' />
        <zone flipboard-zone-id='5' forceUpdate='true' h='26658' id='6' story-point-id='3' type-v2='text' w='54235' x='23616' y='35587'>
          <formatted-text>
            <run bold='true' fontcolor='#ffffff' fontsize='28'>Vanguard Digital Experience A/B Test</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#ffffff' fontsize='18'>Evaluating the impact of the new onboarding experience</run>
          </formatted-text>
        </zone>
        <zone flipboard-zone-id='5' forceUpdate='true' h='25522' id='7' story-point-id='3' type-v2='text' w='37103' x='18063' y='65224'>
          <formatted-text>
            <run bold='true' fontalignment='0' fontcolor='#ffffff'>UX | UI &amp; Customer Experience Team</run>
            <run fontalignment='0'>Æ&#10;</run>
            <run fontalignment='0' fontcolor='#ffffff'>. Valeria Acevedo</run>
            <run fontalignment='0'>Æ&#10;</run>
            <run fontalignment='0' fontcolor='#ffffff'>. Lucila González</run>
            <run fontalignment='0'>Æ&#10;</run>
          </formatted-text>
        </zone>
        <zone flipboard-zone-id='5' forceUpdate='true' h='33673' hidden='true' id='8' story-point-id='4' type-v2='text' w='40228' x='3664' y='37628'>
          <formatted-text>
            <run fontcolor='#000000' lmargin='600' rmargin='600'>Redesigned our onboarding experience to make the process more intuitive, faster and easier to complete.</run>
            <run lmargin='600' rmargin='600'>Æ&#10;&#10;</run>
            <run fontcolor='#000000' lmargin='600' rmargin='600'>Our challenge was to evaluate whether the new UX actually improved customer performance and engagement.</run>
          </formatted-text>
        </zone>
        <zone flipboard-zone-id='5' forceUpdate='true' h='22066' hidden='true' id='12' story-point-id='6' type-v2='text' w='36482' x='2769' y='39413'>
          <formatted-text>
            <run>Æ&#10;</run>
            <run fontcolor='#941100' fontname='Tableau Bold' fontsize='28'>+3.7% </run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Tableau Bold'>Completion Rate Increase</run>
            <run>Æ&#10;&#10;</run>
            <run fontcolor='#c0c0c0' fontname='Tableau Bold' fontsize='10'>vs control</run>
          </formatted-text>
        </zone>
        <zone flipboard-zone-id='5' forceUpdate='true' h='9056' hidden='true' id='13' story-point-id='6' type-v2='text' w='44625' x='29805' y='21939'>
          <formatted-text>
            <run bold='true' fontcolor='#ffffff' fontname='Tableau Bold' fontsize='15'>The redesign delivered strong results</run>
          </formatted-text>
        </zone>
        <zone flipboard-zone-id='5' forceUpdate='true' h='22066' hidden='true' id='14' story-point-id='6' type-v2='text' w='27679' x='37500' y='39413'>
          <formatted-text>
            <run fontcolor='#941100' fontname='Tableau Bold' fontsize='28'>+7.04%</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Tableau Bold'>Error Rate</run>
            <run>Æ&#10;</run>
            <run fontcolor='#c0c0c0' fontname='Tableau Bold' fontsize='10'>vs control</run>
          </formatted-text>
        </zone>
        <zone flipboard-zone-id='5' forceUpdate='true' h='19005' hidden='true' id='15' story-point-id='6' type-v2='text' w='24919' x='70277' y='42219'>
          <formatted-text>
            <run fontcolor='#941100' fontname='Tableau Bold' fontsize='28'>+4.8 pts</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Tableau Bold'>Improvement Among 60+ Users</run>
            <run>Æ&#10;&#10;</run>
            <run fontcolor='#c0c0c0' fontname='Tableau Bold' fontsize='10'>vs control</run>
          </formatted-text>
        </zone>
        <zone flipboard-zone-id='5' forceUpdate='true' h='6122' hidden='true' id='26' story-point-id='4' type-v2='text' w='25489' x='3257' y='21046'>
          <formatted-text>
            <run bold='true' fontcolor='#ffffff' fontname='Tableau Bold' fontsize='15'> THE CHALLENGE</run>
          </formatted-text>
        </zone>
        <zone flipboard-zone-id='5' forceUpdate='true' h='78954' hidden='true' id='29' story-point-id='18' type-v2='text' w='89902' x='5537' y='17985' />
        <zone flipboard-zone-id='5' forceUpdate='true' h='5612' hidden='true' id='28' story-point-id='18' type-v2='text' w='21987' x='5619' y='21556'>
          <formatted-text>
            <run bold='true' fontcolor='#ffffff' fontname='Tableau Bold' fontsize='15'>COMPLETION RATE</run>
          </formatted-text>
        </zone>
        <zone flipboard-zone-id='5' forceUpdate='true' h='23597' hidden='true' id='30' story-point-id='18' type-v2='text' w='28013' x='61075' y='32781'>
          <formatted-text>
            <run fontcolor='#000000'>Key Insights:</run>
            <run>Æ&#10;</run>
            <run fontalignment='0'>Æ&#10;</run>
            <run fontalignment='0' fontcolor='#000000'>✔️ More users complete the process with the new experience </run>
            <run fontalignment='0'>Æ&#10;&#10;</run>
            <run bold='true' fontalignment='0' fontcolor='#000000' fontsize='15'>✔️+3.7</run>
            <run fontalignment='0' fontcolor='#000000'> p.p. improvement </run>
          </formatted-text>
        </zone>
        <zone flipboard-zone-id='5' forceUpdate='true' h='4082' hidden='true' id='31' story-point-id='19' type-v2='text' w='38844' x='31678' y='23597'>
          <formatted-text>
            <run bold='true' fontcolor='#000000' fontsize='18'>The redesign works across all age groups</run>
