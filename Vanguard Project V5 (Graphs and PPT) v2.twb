        <zone flipboard-zone-id='5' forceUpdate='true' h='26658' hidden='true' id='6' story-point-id='3' type-v2='text' w='54235' x='23616' y='35587'>
          <formatted-text>
            <run bold='true' fontcolor='#ffffff' fontsize='28'>Vanguard Digital Experience A/B Test</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#ffffff' fontsize='18'>Evaluating the impact of the new onboarding experience</run>
          </formatted-text>
        </zone>
        <zone flipboard-zone-id='5' forceUpdate='true' h='25522' hidden='true' id='7' story-point-id='3' type-v2='text' w='37103' x='18063' y='65224'>
          <formatted-text>
            <run bold='true' fontalignment='0' fontcolor='#ffffff'>UX | UI &amp; Customer Experience Team</run>
            <run fontalignment='0'>Æ&#10;</run>
            <run fontalignment='0' fontcolor='#ffffff'>. Valeria Acevedo</run>
            <run fontalignment='0'>Æ&#10;</run>
            <run fontalignment='0' fontcolor='#ffffff'>. Lucila González</run>
            <run fontalignment='0'>Æ&#10;</run>
          </formatted-text>
        </zone>
        <zone flipboard-zone-id='5' forceUpdate='true' h='33673' hidden='true' id='8' story-point-id='4' type-v2='text' w='40228' x='3664' y='37628'>
          <formatted-text>
            <run fontcolor='#000000' lmargin='600' rmargin='600'>Redesigned our onboarding experience to make the process more intuitive, faster and easier to complete.</run>
            <run lmargin='600' rmargin='600'>Æ&#10;&#10;</run>
            <run fontcolor='#000000' lmargin='600' rmargin='600'>Our challenge was to evaluate whether the new UX actually improved customer performance and engagement.</run>
          </formatted-text>
        </zone>
        <zone flipboard-zone-id='5' forceUpdate='true' h='22066' hidden='true' id='12' story-point-id='6' type-v2='text' w='36482' x='2769' y='39413'>
          <formatted-text>
            <run>Æ&#10;</run>
            <run fontcolor='#941100' fontname='Tableau Bold' fontsize='28'>+3.7% </run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Tableau Bold'>Completion Rate Increase</run>
            <run>Æ&#10;&#10;</run>
            <run fontcolor='#c0c0c0' fontname='Tableau Bold' fontsize='10'>vs control</run>
          </formatted-text>
        </zone>
        <zone flipboard-zone-id='5' forceUpdate='true' h='9056' hidden='true' id='13' story-point-id='6' type-v2='text' w='44625' x='29805' y='21939'>
          <formatted-text>
            <run bold='true' fontcolor='#ffffff' fontname='Tableau Bold'>The redesign delivered strong results</run>
          </formatted-text>
        </zone>
        <zone flipboard-zone-id='5' forceUpdate='true' h='22066' hidden='true' id='14' story-point-id='6' type-v2='text' w='27606' x='37215' y='40944'>
          <formatted-text>
            <run fontcolor='#941100' fontname='Tableau Bold' fontsize='28'>-5.9s</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Tableau Bold'>Faster Completion Time</run>
            <run>Æ&#10;&#10;</run>
            <run fontcolor='#c0c0c0' fontname='Tableau Bold' fontsize='10'>vs control</run>
          </formatted-text>
        </zone>
        <zone flipboard-zone-id='5' forceUpdate='true' h='19005' hidden='true' id='15' story-point-id='6' type-v2='text' w='24919' x='70277' y='42219'>
          <formatted-text>
            <run fontcolor='#941100' fontname='Tableau Bold' fontsize='28'>+4.8 pts</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Tableau Bold'>Improvement Among 60+ Users</run>
            <run>Æ&#10;&#10;</run>
            <run fontcolor='#c0c0c0' fontname='Tableau Bold' fontsize='10'>vs control</run>
          </formatted-text>
        </zone>
        <zone flipboard-zone-id='5' forceUpdate='true' h='6122' hidden='true' id='26' story-point-id='4' type-v2='text' w='25489' x='3257' y='20026'>
          <formatted-text>
            <run bold='true' fontcolor='#ffffff' fontname='Benton Sans Book'> THE CHALLENGE</run>
          </formatted-text>
        </zone>
        <zone flipboard-zone-id='5' h='6760' hidden='true' id='27' story-point-id='4' type-v2='text' w='25489' x='2362' y='90179' />
        <zone flipboard-zone-id='5' forceUpdate='true' h='5612' hidden='true' id='28' story-point-id='18' type-v2='text' w='21987' x='5700' y='21684'>
          <formatted-text>
            <run bold='true' fontcolor='#ffffff' fontname='Benton Sans Book'>COMPLETION RATE</run>
          </formatted-text>
        </zone>
        <zone flipboard-zone-id='5' forceUpdate='true' h='77168' hidden='true' id='29' story-point-id='18' type-v2='text' w='89902' x='5537' y='19770' />
        <zone flipboard-zone-id='5' forceUpdate='true' h='23597' hidden='true' id='30' story-point-id='18' type-v2='text' w='28013' x='61075' y='32781'>
          <formatted-text>
            <run bold='true' fontcolor='#000000' underline='true'>Key Insights:</run>
            <run>Æ&#10;</run>
            <run fontalignment='0'>Æ&#10;</run>
            <run fontalignment='0' fontcolor='#000000'>✔️ More users complete the process with the new experience </run>
            <run fontalignment='0'>Æ&#10;&#10;</run>
            <run bold='true' fontalignment='0' fontcolor='#000000' fontsize='15'>✔️+3.7</run>
            <run fontalignment='0' fontcolor='#000000'> p.p. improvement </run>
          </formatted-text>
        </zone>
        <zone flipboard-zone-id='5' forceUpdate='true' h='4082' id='31' story-point-id='19' type-v2='text' w='38844' x='31678' y='23597'>
          <formatted-text>
            <run bold='true' fontcolor='#000000' fontsize='18'>The redesign works across all age groups</run>
          </formatted-text>
        </zone>
        <zone flipboard-zone-id='5' forceUpdate='true' h='3954' id='36' story-point-id='19' type-v2='text' w='6107' x='14984' y='46811'>
          <formatted-text>
            <run bold='true' fontcolor='#009051' fontsize='10'>+6.8 pts</run>
          </formatted-text>
        </zone>
        <zone flipboard-zone-id='5' forceUpdate='true' h='3827' id='37' story-point-id='19' type-v2='text' w='6026' x='27199' y='47194'>
          <formatted-text>
            <run bold='true' fontcolor='#009051' fontsize='10'>+2.8 pts</run>
          </formatted-text>
        </zone>
        <zone flipboard-zone-id='5' h='3827' id='38' story-point-id='19' type-v2='text' w='6107' x='39739' y='47704'>
          <formatted-text>
            <run bold='true' fontcolor='#009051' fontsize='10'>+1.9 pts</run>
          </formatted-text>
        </zone>
        <zone flipboard-zone-id='5' h='3827' id='39' story-point-id='19' type-v2='text' w='5700' x='53094' y='47321'>
          <formatted-text>
            <run bold='true' fontcolor='#009051' fontsize='10'>+2.0 pts</run>
          </formatted-text>
        </zone>
        <zone flipboard-zone-id='5' h='3827' id='40' story-point-id='19' type-v2='text' w='6433' x='65147' y='47832'>
          <formatted-text>
            <run bold='true' fontcolor='#009051' fontsize='10'>+4.8 pts</run>
          </formatted-text>
        </zone>
        <zone flipboard-zone-id='5' forceUpdate='true' h='4847' id='41' story-point-id='19' type-v2='text' w='21743' x='3094' y='21301'>
          <formatted-text>
            <run bold='true' fontcolor='#fffef5' fontname='Benton Sans SemiDemi'>DEMOGRAPHIC IMPACT</run>
          </formatted-text>
        </zone>
        <zone flipboard-zone-id='5' forceUpdate='true' h='75638' id='42' story-point-id='19' type-v2='text' w='93811' x='3176' y='19770' />
        <zone flipboard-zone-id='5' forceUpdate='true' h='8418' hidden='true' id='49' story-point-id='22' type-v2='text' w='51629' x='26792' y='23597'>
          <formatted-text>
            <run bold='true' fontcolor='#000000' fontsize='18'>Step 1 remains the primary friction point</run>
          </formatted-text>
        </zone>
        <zone flipboard-zone-id='5' forceUpdate='true' h='5357' hidden='true' id='50' story-point-id='22' type-v2='text' w='25489' x='3420' y='20663'>
          <formatted-text>
            <run bold='true' fontcolor='#ffffff'>UX FRICTION POINT</run>
          </formatted-text>
        </zone>
        <zone flipboard-zone-id='5' forceUpdate='true' h='6633' hidden='true' id='51' story-point-id='6' type-v2='text' w='51384' x='27524' y='69898'>
          <formatted-text>
            <run bold='true' fontalignment='0' fontcolor='#000000'>🏆 The redesign improved performance across all customer segments</run>
          </formatted-text>
        </zone>
        <zone flipboard-zone-id='5' forceUpdate='true' h='18240' hidden='true' id='52' story-point-id='23' type-v2='text' w='30700' x='2117' y='34566'>
          <formatted-text>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>1. Roll out the redesigned experience</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Benton Sans Book'> to all users.The new onboarding flow </run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Benton Sans Book'>improves completion rates and overall navigation performance.</run>
          </formatted-text>
        </zone>
        <zone flipboard-zone-id='5' forceUpdate='true' h='5102' hidden='true' id='53' story-point-id='23' type-v2='text' w='32980' x='6433' y='18878'>
          <formatted-text>
            <run bold='true' fontcolor='#ffffff' fontname='Benton Sans Book'>RECOMMENDATIONS &amp; NEXTS STEPS</run>
          </formatted-text>
        </zone>
        <zone flipboard-zone-id='5' forceUpdate='true' h='18112' hidden='true' id='54' story-point-id='23' type-v2='text' w='31352' x='34365' y='34566'>
          <formatted-text>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>2. Prioritize redesign of Step 1  </run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Benton Sans Book'>Users still experience higher friction, </run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Benton Sans Book'>longer navigation time and increased</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Benton Sans Book'> drop-off at this stage</run>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>.</run>
          </formatted-text>
        </zone>
        <zone flipboard-zone-id='5' forceUpdate='true' h='17602' hidden='true' id='55' story-point-id='23' type-v2='text' w='29153' x='67834' y='35077'>
          <formatted-text>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>3. Continue monitoring post-launch behavior.</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Benton Sans Book'>Track KPIs and user interactions to identify future optimization opportunities.</run>
          </formatted-text>
        </zone>
        <zone flipboard-zone-id='5' h='6888' hidden='true' id='56' story-point-id='4' type-v2='text' w='10668' x='44137' y='76148'>
          <formatted-text>
